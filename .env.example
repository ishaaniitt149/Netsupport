# ==============================================================================
# Environment Configuration (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to `.env`: `cp .env.example .env`
# 2. Populate the required secrets (e.g., OPENAI_API_KEY).
# 3. DO NOT commit the `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# App Settings
# ------------------------------------------------------------------------------
APP_NAME=network-operations-intelligence
APP_ENV=development  # Use 'production' for strict logging and performance settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Security & Privacy Settings
# ------------------------------------------------------------------------------
# Controls whether raw Cisco CLI command outputs are sent to the LLM.
# Set to 'False' (default) to scrub sensitive infrastructure data.
# Set to 'True' ONLY if using a self-hosted, private, zero-retention LLM model.
LLM_ALLOW_RAW_INFRASTRUCTURE_DATA=False

# ------------------------------------------------------------------------------
# LLM Integration
# ------------------------------------------------------------------------------
LLM_PROVIDER=mock                # Options: 'mock', 'openai'
LLM_MODEL_NAME=gpt-4o-mini
# LLM_API_KEY=sk-xxxxxx         # Provide key if LLM_PROVIDER is not 'mock'
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# Synthetic Data Simulation
# ------------------------------------------------------------------------------
SIMULATION_SEED=42
SYNTHETIC_DEVICE_COUNT=100
DEFAULT_CORRELATION_WINDOW_MINUTES=60
