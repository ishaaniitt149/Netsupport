# ==============================================================================
# Network Operations Intelligence & Predictive Maintenance Platform (NOIPMP)
# Environment Configuration Template
# NOTE: Do NOT put real secrets or credentials in this file or any Git repo.
# ==============================================================================

# Application Settings
APP_NAME=network-operations-intelligence
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Synthetic Data & Simulation Settings
SIMULATION_SEED=42
SYNTHETIC_DEVICE_COUNT=100
DEFAULT_CORRELATION_WINDOW_MINUTES=60

# Model Settings
ML_MODEL_PATH=data/models/random_forest_v1.joblib
RISK_THRESHOLD_HIGH=70.0
RISK_THRESHOLD_CRITICAL=85.0

# LLM Provider Configuration (Abstracted - no secrets in code)
# Supported: mock, openai, azure_openai, ollama
LLM_PROVIDER=mock
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY is injected via environment variable or secret scope at runtime
LLM_API_KEY=
